+    /**
+     * 获取某个链接的缓存情况：contentLength 为文件总大小（未知时为 -1），cachedBytes 为已缓存的字节数
+     */
+    public void getCacheInfo(String url, Promise promise) {
+        WritableMap map = Arguments.createMap();
+        long contentLength = C.LENGTH_UNSET;
+        long cachedBytes = 0;
+        if (cache != null) {
+            try {
+                contentLength = ContentMetadata.getContentLength(cache.getContentMetadata(url));
+                if (contentLength > 0) {
+                    cachedBytes = cache.getCachedBytes(url, 0, contentLength);
+                } else {
+                    for (CacheSpan span : cache.getCachedSpans(url)) {
+                        if (span.isCached) cachedBytes += span.length;
+                    }
+                }
+            } catch (Exception e) {
+                Log.w(Utils.LOG, "getCacheInfo failed: " + e.getMessage());
+            }
+        }
+        map.putDouble("contentLength", contentLength);
+        map.putDouble("cachedBytes", cachedBytes);
+        promise.resolve(map);
+    }
+
+    /**
+     * 把完整缓存的歌曲导出到指定文件，缓存不完整时返回 false
+     */
+    public void exportCache(String url, String destPath, Promise promise) {
+        final SimpleCache currentCache = cache;
+        if (currentCache == null) {
+            promise.resolve(false);
+            return;
+        }
+        new Thread(() -> {
+            File destFile = new File(destPath);
+            boolean success = false;
+            try {
+                long contentLength = ContentMetadata.getContentLength(currentCache.getContentMetadata(url));
+                if (contentLength > 0 && currentCache.isCached(url, 0, contentLength)) {
+                    File parent = destFile.getParentFile();
+                    if (parent != null && !parent.exists()) parent.mkdirs();
+                    long position = 0;
+                    byte[] buffer = new byte[64 * 1024];
+                    try (OutputStream out = new FileOutputStream(destFile)) {
+                        for (CacheSpan span : currentCache.getCachedSpans(url)) {
+                            if (position >= contentLength) break;
+                            if (!span.isCached || span.file == null) continue;
+                            long spanEnd = span.position + span.length;
+                            if (spanEnd <= position) continue;
+                            if (span.position > position) break; // 中间有空洞
+                            long skip = position - span.position;
+                            long remaining = Math.min(spanEnd, contentLength) - position;
+                            try (InputStream in = new FileInputStream(span.file)) {
+                                long skipped = 0;
+                                while (skipped < skip) {
+                                    long n = in.skip(skip - skipped);
+                                    if (n <= 0) throw new IOException("skip failed");
+                                    skipped += n;
+                                }
+                                while (remaining > 0) {
+                                    int n = in.read(buffer, 0, (int) Math.min(buffer.length, remaining));
+                                    if (n < 0) throw new IOException("unexpected end of cache span");
+                                    out.write(buffer, 0, n);
+                                    remaining -= n;
+                                    position += n;
+                                }
+                            }
+                        }
+                    }
+                    success = position >= contentLength;
+                }
+            } catch (Exception e) {
+                Log.w(Utils.LOG, "exportCache failed: " + e.getMessage());
+                success = false;
+            }
+            if (!success && destFile.exists()) destFile.delete();
+            promise.resolve(success);
+        }).start();
+    }
